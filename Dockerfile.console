FROM --platform=$BUILDPLATFORM node:24.13.0-alpine@sha256:cd6fb7efa6490f039f3471a189214d5f548c11df1ff9e5b181aa49e22c14383e AS build
WORKDIR /src/console
COPY console/package.json console/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY console/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6
ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE=https://github.com/ccsert/artifact-gateway
LABEL org.opencontainers.image.title="Artifact Gateway Console" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.source="$SOURCE"
COPY deploy/kubernetes/console/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/console/dist /usr/share/nginx/html
EXPOSE 8080
