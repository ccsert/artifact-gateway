<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>artifact-gateway-proxy</id>
      <name>Artifact Gateway Maven Proxy</name>
      <url>${env.GATEWAY_MAVEN_PROXY_URL}</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>artifact-gateway-proxy</id>
      <username>${env.GATEWAY_MAVEN_USERNAME}</username>
      <password>${env.GATEWAY_MAVEN_PASSWORD}</password>
    </server>
  </servers>
</settings>
