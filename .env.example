# Copy to .env and change values before starting the fixture. Do not commit .env.
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_POSTGRES_PASSWORD=replace-with-a-local-password
GITEA_ADMIN_USERNAME=fixture-admin
GITEA_ADMIN_PASSWORD=replace-with-a-local-admin-password
GITEA_ADMIN_EMAIL=fixture-admin@example.test
GITEA_FIXTURE_USERNAME=gateway-fixture
GITEA_FIXTURE_PASSWORD=replace-with-a-local-fixture-password
GITEA_FIXTURE_EMAIL=gateway-fixture@example.test
GITEA_FIXTURE_ORG=gateway-fixtures

# Gateway development stack. Use distinct local-only values; never commit .env.
GATEWAY_HTTP_PORT=8080
GATEWAY_POSTGRES_PORT=5432
GATEWAY_POSTGRES_PASSWORD=replace-with-a-local-gateway-db-password
# Runtime placement. The default standalone role expands to api,scheduler,worker.
# Cluster examples:
#   API node:       GATEWAY_NODE_ROLES=api
#   scheduler node: GATEWAY_NODE_ROLES=scheduler
#   OCI workers:    GATEWAY_NODE_ROLES=worker and GATEWAY_WORKER_FORMATS=oci
GATEWAY_NODE_ROLES=standalone
GATEWAY_INSTANCE_ID=
# Worker filters apply to format-specific reclaim, promotion, replication,
# retention, and cache workers. Unset means all formats and job kinds.
GATEWAY_WORKER_FORMATS=
GATEWAY_WORKER_KINDS=
# The primary pool serves requests and background jobs. Reduce all pool limits
# per replica when many Gateway instances share the same PostgreSQL server.
GATEWAY_DATABASE_MAX_OPEN_CONNS=32
GATEWAY_DATABASE_MAX_IDLE_CONNS=8
# Advisory locks hold connections for the duration of cache fills. Their
# dedicated pool prevents lock contention from exhausting request connections.
GATEWAY_DATABASE_COORDINATOR_MAX_OPEN_CONNS=8
GATEWAY_DATABASE_COORDINATOR_MAX_IDLE_CONNS=2
# Two additional connections are reserved for multiplexed LISTEN/NOTIFY work.
GATEWAY_DATABASE_CONN_MAX_LIFETIME=30m
GATEWAY_DATABASE_CONN_MAX_IDLE_TIME=5m
GATEWAY_ADMIN_TOKEN=replace-with-a-local-gateway-admin-token
GATEWAY_RESOLVER_TOKEN=replace-with-a-local-gateway-resolver-token
# 32-byte key (hex/base64/raw) encrypting stored egress proxy credentials.
# Generate with: openssl rand -hex 32
GATEWAY_EGRESS_PROXY_KEY=
# 32-byte key used to encrypt runtime-managed authentication credentials.
GATEWAY_SETTINGS_ENCRYPTION_KEY=
GATEWAY_REPOSITORY_READERS=
# Optional logical cache quotas in bytes: repository=bytes;repository=bytes.
# OCI repository names include their namespace (for example team/app); Maven
# repository names are their configured Gateway group names.
GATEWAY_REPOSITORY_CACHE_QUOTAS=
# Optional OIDC bearer-token validation. When enabled, the JWT `sub` is the
# repository-read identity; configure GATEWAY_REPOSITORY_READERS for those subjects.
# Issuer and JWKS endpoints must use HTTPS, except for localhost/127.0.0.1/::1
# during local development.
GATEWAY_OIDC_ISSUER=
GATEWAY_OIDC_AUDIENCE=
GATEWAY_OIDC_JWKS_URL=
# Optional browser SSO. The Console discovers this runtime configuration from
# the Gateway, so changing providers does not require rebuilding the frontend.
# Client secret is optional for public PKCE clients. HTTP callbacks are only
# accepted for localhost development.
GATEWAY_OIDC_CLIENT_ID=
GATEWAY_OIDC_CLIENT_SECRET=
GATEWAY_OIDC_REDIRECT_URL=
GATEWAY_OIDC_SCOPES=openid profile email
GATEWAY_OIDC_ADMIN_SUBJECTS=
# Optional Keycloak realm-role mappings. No role mapping is enabled unless the
# corresponding list is explicitly configured. Higher roles win when several match.
GATEWAY_OIDC_READER_ROLES=
GATEWAY_OIDC_WRITER_ROLES=
GATEWAY_OIDC_ADMIN_ROLES=
# Optional OpenTelemetry OTLP/HTTP collector endpoint (host:port) and head
# sampling ratio between 0 and 1. Without an endpoint, traces are unsampled.
GATEWAY_OTLP_HTTP_ENDPOINT=
GATEWAY_OTEL_SAMPLING_RATIO=1
GATEWAY_GITEA_USERNAME=replace-with-a-gitea-read-username
GATEWAY_GITEA_TOKEN=replace-with-a-gitea-read-token
GATEWAY_OCI_PROXY_ALLOWED_HOSTS=
GATEWAY_MAVEN_PROXY_ALLOWED_HOSTS=
GATEWAY_RAW_PROXY_ALLOWED_HOSTS=
# Optional maximum cached object size in bytes for Raw and Conan Proxy reads.
# Each defaults to 1073741824 (1 GiB) when unset.
GATEWAY_RAW_CACHE_MAX_OBJECT_BYTES=
GATEWAY_CONAN_CACHE_MAX_OBJECT_BYTES=
# Optional proxy cache TTL per format, as a Go duration ("30m", "1h30m") or a
# positive integer number of seconds ("900"). OCI, Raw, and Conan default to
# 15m. Maven components default to 24h; Maven metadata and negative responses
# have independent defaults of 15m and 10m.
GATEWAY_OCI_CACHE_TTL=
GATEWAY_MAVEN_CACHE_TTL=
GATEWAY_MAVEN_METADATA_CACHE_TTL=
GATEWAY_MAVEN_NEGATIVE_CACHE_TTL=
GATEWAY_RAW_CACHE_TTL=
GATEWAY_CONAN_CACHE_TTL=
MINIO_ROOT_USER=replace-with-a-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
