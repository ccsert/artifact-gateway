{
  "name": "artifact-gateway-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-ts -f hey-api.config.ts && prettier --ignore-path /dev/null --write src/client/types.gen.ts",
    "check:api": "npm run generate:api",
    "antd:doctor": "antd doctor --format json",
    "antd:lint": "antd lint src --format json",
    "antd:usage": "antd usage src --format json",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "antd": "^6.5.3",
    "dayjs": "^1.11.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.5.4",
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "js-yaml": "5.2.3",
    "nanoid": "3.3.18"
  }
}
