{
  "name": "artifact-gateway-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "generate:api": "openapi-ts -f hey-api.config.ts && prettier --write src/client/types.gen.ts",
    "check:api": "npm run generate:api",
    "antd:doctor": "antd doctor --format json",
    "antd:lint": "antd lint src --format json",
    "antd:usage": "antd usage src --format json",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.5.3",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "js-yaml": "5.2.3"
  }
}
