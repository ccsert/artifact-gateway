{
  "name": "artifact-gateway-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "generate:api": "openapi-ts -f hey-api.config.ts",
    "check:api": "npm run generate:api",
    "e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.72.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0"
  }
}
